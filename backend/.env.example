# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME=Wallcano Inventory Management
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# QuickBooks Online
QBO_CLIENT_ID=your_intuit_client_id_here
QBO_CLIENT_SECRET=your_intuit_client_secret_here
QBO_REDIRECT_URI=http://localhost:8000/api/v1/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# Shopify Inventory Management API
# Shop domain (e.g., your-store.myshopify.com)
SHOPIFY_SHOP_URL=your-store.myshopify.com
# Admin API Access Token (shpat_...) created from Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-04
SHOPIFY_LOCATION_NAME=123 William Street
SHOPIFY_LOCATION_ID=
SHOPIFY_AUTO_SYNC=true

# PostgreSQL Database
DATABASE_URL=postgresql://walcano_app:walcano_db_pass_2026@localhost:5432/walcano_inventory

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Service (for Password Reset OTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# Initial Admin Account Seeding
INITIAL_ADMIN_EMAIL=admin@wallcano.com
INITIAL_ADMIN_PASSWORD=Admin@Wallcano2026!
INITIAL_ADMIN_NAME=Wallcano Admin
