# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME=Walcano Inventory Management
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# QuickBooks Online
QBO_CLIENT_ID=your_intuit_client_id_here
QBO_CLIENT_SECRET=your_intuit_client_secret_here
QBO_REDIRECT_URI=http://localhost:8000/api/v1/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# Optional: Direct tokens if already generated
# QBO_REALM_ID=
# QBO_ACCESS_TOKEN=
# QBO_REFRESH_TOKEN=

# PostgreSQL Database
DATABASE_URL=postgresql://walcano_app:walcano_db_pass_2026@localhost:5432/walcano_inventory

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Service (for Password Reset OTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# Initial Admin Account Seeding
INITIAL_ADMIN_EMAIL=admin@wallcano.com
INITIAL_ADMIN_PASSWORD=Admin@Wallcano2026!
INITIAL_ADMIN_NAME=Wallcano Admin
