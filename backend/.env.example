# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME=Walcano Inventory Management
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# QuickBooks Online
QBO_CLIENT_ID=your_intuit_client_id_here
QBO_CLIENT_SECRET=your_intuit_client_secret_here
QBO_REDIRECT_URI=http://localhost:8000/api/v1/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# Optional: Direct tokens if already generated
# QBO_REALM_ID=
# QBO_ACCESS_TOKEN=
# QBO_REFRESH_TOKEN=

